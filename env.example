#
# Copy this file to `.env` and fill in values.
# Notes:
# - Keep comments in English for operational clarity.
# - Never commit real secrets.
#

# --- GCP Configuration (for Terraform / deployment scripts) ---
# GCP Project ID (used by Terraform and deployment scripts)
GCP_PROJECT_ID=your-gcp-project-id

# GCP Region (default: us-central1)
GCP_REGION=us-central1

# --- LLM providers ---
# Required: used by LiteLLM (primary model).
OPENAI_API_KEY=

# Optional: used for Gemini fallback / query expansion (if enabled in your codepath).
GOOGLE_API_KEY=

# --- Elasticsearch (Serverless / Hosted) ---
ELASTIC_URL=
ELASTIC_API_KEY=

# --- API server ---
# Optional: If set, /chatbot, /search, /search_naive require:
#   Authorization: Bearer <API_AUTH_TOKEN>
# If empty, auth is disabled (useful for local dev).
API_AUTH_TOKEN=

# CORS for browser frontends:
# - "*" allows all origins (easy, less secure)
# - or comma-separated origins, e.g.:
#   https://example.com,https://www.example.com
CORS_ALLOW_ORIGINS=*

# Rate limiting (defaults are 5/min and 30/hour)
RATE_LIMIT_PER_MINUTE=5
RATE_LIMIT_PER_HOUR=30

# Local server port (Cloud Functions sets PORT automatically).
PORT=8080

# --- LangSmith Observability ---
# LangSmith API key (get from https://smith.langchain.com)
LANGSMITH_API_KEY=

# Enable LangSmith tracing (set to "true" to enable)
LANGSMITH_TRACING=false

# LangSmith project name (use different projects for dev/staging/prod)
# Examples: chatbot-milesguo-dev, chatbot-milesguo-staging, chatbot-milesguo-prod
LANGSMITH_PROJECT=chatbot-milesguo-dev

# LangSmith API endpoint (default: https://api.smith.langchain.com)
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Application environment and version (used in trace metadata)
APP_ENV=dev
APP_VERSION=2026-02-18